# Copy this file to .env and fill in the values.
# .env itself is gitignored so real values never get committed.

# --- Database (postgres) ---
DB_USER=tns-capital-db-user
DB_PASSWORD=change-me

# --- JWT shared by the auth stub (signs tokens) and the API (verifies them) ---
# At least 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-bytes

# --- Refresh-token secret, known only to auth-service (never give it to the API) ---
# Must be different from JWT_SECRET. Generate one with: openssl rand -hex 32
JWT_REFRESH_SECRET=change-me-to-a-different-random-value-of-32-bytes

# --- Market data (Alpaca), used by the API's live price pool and the ETL's price history ---
# Free keys: sign up at alpaca.markets, then Paper Trading > API Keys. No funded account needed.
# Leave blank to switch market data off; orders must then include a price.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Live price feed: iex (free plan) or sip (paid plan, all US exchanges)
ALPACA_FEED=iex
# Daily price history feed: sip works on the free plan for data older than 15 minutes
PRICE_HISTORY_FEED=sip
# How many years of daily prices the ETL loads the first time it runs
PRICE_BACKFILL_YEARS=5
