# Copy this file to .env and fill in the values.
# .env itself is gitignored so real values never get committed.
#
# Quick start
#   1. cp .env.example .env
#   2. Fill in the four required values below, which have no default and are refused if left empty:
#        DB_PASSWORD             any password for the local database
#        JWT_SECRET              openssl rand -hex 32
#        ADMIN_PASSWORD          at least 12 characters
#        SUPPORT_PASSWORD        at least 12 characters, different from ADMIN_PASSWORD
#      and STRATEGY_CLIENT_SECRET (openssl rand -hex 32) so Strategy Lab can trade.
#   3. docker compose up -d --build        (or docker-compose on older installs)
#   4. Optional: load the price history for charts and backtests once, instead of waiting for
#      the nightly run:  docker compose run --rm etl python pipeline.py
#
# After pulling changes that add tables or database roles (anything under db/), recreate the
# database once:  docker compose down -v && docker compose up -d --build
# This deletes your local data; Postgres only runs db/ on a fresh volume.

# --- Database (postgres) ---
# The database owner (a superuser): creates the schema, for administrators only.
DB_USER=tns-capital-db-user
DB_PASSWORD=change-me
# Each service logs in with its own least-privilege role (db/roles/roles.sql):
# tns_api, tns_auth, tns_etl, tns_reader (dashboard) and tns_strategy. Their passwords default to
# DB_PASSWORD; set them to give each service its own. Read when the volume is created.
# DB_API_PASSWORD=
# DB_AUTH_PASSWORD=
# DB_ETL_PASSWORD=
# DB_READER_PASSWORD=
# DB_STRATEGY_PASSWORD=

# --- JWT signing key, shared by the auth service (signs tokens) and the trading API, strategy
# service and dashboard (verify them). Anyone who knows it can forge an ADMIN token, so it is
# left empty: generate your own with  openssl rand -hex 32  (at least 32 bytes; "change-me..."
# is refused)
JWT_SECRET=

# --- The staff accounts: the auth service creates each from its password when it starts, and
# updates it if you change it. At least 12 characters each, and different; nothing is seeded.
# Each signs in with its email: the ones below unless you change them.
# admin (ADMIN role): the analytics dashboard (/analytics/) and operations (DLQ, metrics)
ADMIN_EMAIL=admin@tns-capital.local
ADMIN_PASSWORD=
# support (SUPPORT role): the trading app's account viewer, suspending and reactivating accounts
SUPPORT_EMAIL=support@tns-capital.local
SUPPORT_PASSWORD=

# --- Jane Doe demo trader (optional) ---
# When set, login with jane.doe@example.com and this password. It is used only to
# create/update the USER linked to the seeded ACC-DEMO-JANE account.
DEMO_PASSWORD=

# --- Strategy Lab: the strategy service logs in to the auth service with this secret to place
# its strategies' orders (role STRATEGY). Without it strategies cannot trade. At least 32
# characters; generate one with  openssl rand -hex 32
STRATEGY_CLIENT_SECRET=
# How many strategies one account may have switched on at once
# STRATEGY_MAX_ACTIVE_PER_ACCOUNT=3

# --- Market data (Alpaca), used by the API's live price pool and the ETL's price history ---
# Free keys: sign up at alpaca.markets, then Paper Trading > API Keys. No funded account needed.
# Leave blank to switch market data off: orders must then include a price, and Strategy Lab's
# replay and the ETL's price history (backtests) are unavailable.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Live price feed: iex (free plan) or sip (paid plan, all US exchanges)
ALPACA_FEED=iex
# Weekly newsletter (top movers): when the API publishes it, as a Spring cron
# in New York time. Default: Fridays at 17:00, after the close. Set to - to switch it off.
NEWSLETTER_CRON=0 0 17 * * FRI
# true lets support staff publish the week's issue before Friday, e.g. for a demo. The Friday run then
# skips that week, so leave it false in production.
NEWSLETTER_EARLY_PUBLISH=false
# Daily price history feed: sip works on the free plan for data older than 15 minutes
PRICE_HISTORY_FEED=sip
# How many years of daily prices the ETL loads the first time it runs
PRICE_BACKFILL_YEARS=5

# --- Monitoring (observability/README.md) ---
# Starts the monitoring stack (~90 MB) with every `docker compose up`, and stops it with `down`.
# Leave unset to run it only on request: docker compose --profile observability up -d
COMPOSE_PROFILES=observability

# --- Optional settings: the defaults below are used when these are left commented out ---
# Host ports, if the defaults clash with something on your machine
# FRONTEND_PORT=8086
# DASHBOARD_PORT=8501
# KAFKA_UI_PORT=8090
# Log format of the Java services: one JSON object per line, as ecs, logstash or gelf
# LOG_FORMAT=ecs
# Log format of the auth service: json (one object per line) or text
# AUTH_LOG_FORMAT=json
# Auth requests (register, login, refresh, token) allowed per client IP per minute
# AUTH_RATE_LIMIT=10
# How long the broker simulator takes to fill an order
# BROKER_MIN_DELAY=500ms
# BROKER_MAX_DELAY=2000ms
# When the ETL runs each day (UTC, HH:MM)
# ETL_SCHEDULE_TIME=02:00
# Where Docker keeps container logs, for the monitoring stack's log collector (Docker Desktop and
# rootless Docker may differ)
# DOCKER_CONTAINERS_DIR=/var/lib/docker/containers
