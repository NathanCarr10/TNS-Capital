{
  "openapi": "3.0.1",
  "info": {
    "title": "Strategy API",
    "description": "Strategy Lab: backtest trading rules and run them on the live price stream",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the frontend"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "strategies",
      "description": "Backtest trading rules and run them on the live price stream"
    }
  ],
  "paths": {
    "/api/v1/strategies/{id}/status": {
      "put": {
        "tags": [
          "strategies"
        ],
        "summary": "Switch a strategy on or off",
        "description": "ACTIVE: it trades on each 1-minute bar of its symbol. PAUSED: it stops. Only one strategy per account can be on at a time (strategy.max-active-per-account).",
        "operationId": "changeStrategyStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 Not on the caller's account (admins cannot change strategies)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "STR-404 Strategy not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "STR-409 Another strategy is on, or the strategy is deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VAL-422 Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/strategies": {
      "get": {
        "tags": [
          "strategies"
        ],
        "summary": "List strategies",
        "description": "A trader's own strategies; every strategy for admins. Deleted (archived) ones are left out.",
        "operationId": "listStrategies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StrategyResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 Not allowed with this token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "strategies"
        ],
        "summary": "Create a strategy",
        "description": "On the caller's own account, PAUSED until switched on. Missing rule settings take their defaults.",
        "operationId": "createStrategy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStrategyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 The caller has no trading account (admins)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "INS-404 Instrument not found or not tradable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VAL-422 Invalid input; STR-422 rule settings out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/strategies/backtests": {
      "post": {
        "tags": [
          "strategies"
        ],
        "summary": "Backtest a rule",
        "description": "Runs the rule over the symbol's daily closes (analytics.fact_daily_prices, default the last five years): long only, all its cash in whole shares on BUY, all sold on SELL, at the day's close, no fees. Compared with buying on the first day and holding.",
        "operationId": "runBacktest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BacktestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestResult"
                }
              }
            }
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 Not allowed with this token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "PRC-404 Not enough price history for the rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VAL-422 Invalid input; STR-422 rule settings out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/strategies/{id}": {
      "get": {
        "tags": [
          "strategies"
        ],
        "summary": "Get a strategy",
        "description": "With the 1-minute bars collected so far for its symbol, live and replayed.",
        "operationId": "getStrategy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 Not on the caller's account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "STR-404 Strategy not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "strategies"
        ],
        "summary": "Delete a strategy",
        "description": "It stops trading and is archived, so its signals stay on record.",
        "operationId": "deleteStrategy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 Not on the caller's account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "STR-404 Strategy not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/strategies/{id}/signals": {
      "get": {
        "tags": [
          "strategies"
        ],
        "summary": "A strategy's signals",
        "description": "The latest 100, newest first, each with the order it placed and that order's status now.",
        "operationId": "listStrategySignals",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SignalResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 Not on the caller's account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "STR-404 Strategy not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/strategies/activity": {
      "get": {
        "tags": [
          "strategies"
        ],
        "summary": "Recent signals of all the caller's strategies",
        "description": "Signals since the given time, newest first (at most 100), for notifications. Admins get every strategy's.",
        "operationId": "listStrategyActivity",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SignalResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTH-401 Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "AUTH-403 Not allowed with this token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VAL-422 since is missing or not an ISO-8601 time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "SYS-500 Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StatusChangeRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PAUSED",
              "ARCHIVED",
              "ACTIVE",
              "PAUSED"
            ]
          }
        }
      },
      "SeriesView": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "LIVE",
              "REPLAY"
            ]
          },
          "replayId": {
            "type": "string"
          },
          "barsCollected": {
            "type": "integer",
            "format": "int32"
          },
          "lastClose": {
            "type": "number"
          },
          "lastBarTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StrategyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "ruleType": {
            "type": "string",
            "enum": [
              "MA_CROSSOVER",
              "BOLLINGER"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "rule": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PAUSED",
              "ARCHIVED"
            ]
          },
          "position": {
            "type": "string",
            "enum": [
              "FLAT",
              "LONG"
            ]
          },
          "barsNeeded": {
            "type": "integer",
            "format": "int32"
          },
          "market": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeriesView"
            }
          },
          "createdOn": {
            "type": "string",
            "format": "date-time"
          },
          "updatedOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateStrategyRequest": {
        "required": [
          "name",
          "quantity",
          "ruleType",
          "symbol"
        ],
        "type": "object",
        "properties": {
          "name": {
            "pattern": "^[\\p{L}\\p{M}\\p{N} .,'/_-]{1,80}$",
            "type": "string"
          },
          "symbol": {
            "pattern": "^[A-Z]{1,10}$",
            "type": "string"
          },
          "ruleType": {
            "type": "string",
            "enum": [
              "MA_CROSSOVER",
              "BOLLINGER"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "description": "MA_CROSSOVER: shortWindow (default 20), longWindow (default 50). BOLLINGER: window (default 20), width in standard deviations (default 2)",
              "format": "double"
            },
            "description": "MA_CROSSOVER: shortWindow (default 20), longWindow (default 50). BOLLINGER: window (default 20), width in standard deviations (default 2)",
            "example": {
              "shortWindow": 20,
              "longWindow": 50
            }
          },
          "quantity": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BacktestRequest": {
        "required": [
          "ruleType",
          "symbol"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "pattern": "^[A-Z]{1,10}$",
            "type": "string"
          },
          "ruleType": {
            "type": "string",
            "enum": [
              "MA_CROSSOVER",
              "BOLLINGER"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "description": "As for creating a strategy",
              "format": "double"
            },
            "description": "As for creating a strategy",
            "example": {
              "shortWindow": 20,
              "longWindow": 50
            }
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "initialCash": {
            "maximum": 100000000,
            "exclusiveMaximum": false,
            "minimum": 100,
            "exclusiveMinimum": false,
            "type": "number"
          }
        }
      },
      "BacktestResult": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "initialCash": {
            "type": "number"
          },
          "finalValue": {
            "type": "number"
          },
          "totalReturnPct": {
            "type": "number"
          },
          "buyAndHoldReturnPct": {
            "type": "number"
          },
          "maxDrawdownPct": {
            "type": "number"
          },
          "roundTrips": {
            "type": "integer",
            "format": "int32"
          },
          "winningRoundTrips": {
            "type": "integer",
            "format": "int32"
          },
          "trades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BacktestTrade"
            }
          },
          "equityCurve": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquityPoint"
            }
          }
        }
      },
      "BacktestTrade": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "side": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "profit": {
            "type": "number"
          }
        }
      },
      "EquityPoint": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "strategy": {
            "type": "number"
          },
          "buyAndHold": {
            "type": "number"
          }
        }
      },
      "SignalResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "strategyId": {
            "type": "integer",
            "format": "int64"
          },
          "strategyName": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "barTime": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "LIVE",
              "REPLAY"
            ]
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "PLACED",
              "FAILED"
            ]
          },
          "orderStatus": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "createdOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "A user's accessToken from the auth service (POST /auth/login)",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
