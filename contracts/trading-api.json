  "components": {
    "schemas": {
      "CreateInstrumentRequest": {
        "required": [
          "assetClass",
          "currency",
          "name",
          "symbol",
          "tradable"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "pattern": "^[A-Z]{1,10}$",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "assetClass": {
            "pattern": "^[A-Z_]{1,20}$",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "tradable": {
            "type": "boolean"
          }
        }
      },
      "InstrumentResponse": {
        "required": [
          "assetClass",
          "currency",
          "name",
          "symbol",
          "tradable"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "assetClass": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "tradable": {
            "type": "boolean"
          }
        }
      },
      "PlaceOrderRequest": {
        "required": [
          "accountId",
          "idempotencyKey",
          "quantity",
          "side",
          "symbol"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "symbol": {
            "pattern": "^[A-Z]{1,10}$",
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "quantity": {
            "maximum": 1000000,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "maximum": 999999.99,
            "exclusiveMaximum": false,
            "type": "number"
          },
          "idempotencyKey": {
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "type": "string"
          }
        }
      },
      "PlaceOrderResponse": {
        "required": [
          "message",
          "orderId",
          "price",
          "status"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "nullable": true
          },
          "message": {
            "type": "string"
          }
        }
      },
