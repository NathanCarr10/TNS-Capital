meta {
  name: Place Order
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/api/v1/orders
  body: json
  auth: inherit
}

body:json {
  {
    "accountId": {{accountId}},
    "symbol": "ACME",
    "side": "BUY",
    "quantity": 10,
    "price": 100.00,
    "idempotencyKey": "{{$randomUUID}}"
  }
}

script:post-response {
  if (res.status === 202) {
    bru.setEnvVar("orderId", res.body.orderId);
  }
}

assert {
  res.status: eq 202
}

docs {
  side: BUY or SELL. symbol: 1-10 uppercase letters (seeded tradable symbols include ACME).
  A fresh idempotencyKey is generated on every send.
  Saves orderId for Get Order / Order History / Cancel Order.
}
