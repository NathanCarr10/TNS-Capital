meta {
  name: Place Order
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/api/v1/orders
  body: json
  auth: inherit
}

body:json {
  {
    "accountId": {{accountId}},
    "symbol": "AAPL",
    "side": "BUY",
    "quantity": 10,
    "idempotencyKey": "{{$randomUUID}}"
  }
}

script:post-response {
  if (res.status === 202) {
    bru.setEnvVar("orderId", res.body.orderId);
  }
}

assert {
  res.status: eq 202
}

docs {
  side: BUY or SELL. symbol: 1-10 uppercase letters (seeded tradable symbols include AAPL, MSFT, SPY).
  price is optional: without it the order is priced at the live market price, returned as "price".
  Add "price": 230.00 to set a limit yourself (needed when the API runs without Alpaca keys).
  With live prices, limits are immediate-or-cancel: a BUY limit must be at or above the market
  price and a SELL limit at or below it, or the order is refused with 422 ORD-422. A marketable
  limit fills at the market price, never worse than the limit.
  A fresh idempotencyKey is generated on every send.
  Saves orderId for Get Order / Order History / Cancel Order.
}
