meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("accountId", res.body.accountId);
  }
}

assert {
  res.status: eq 201
}

docs {
  Run once per email. Email must be a valid address, password 8+ characters.
  Optional field: "holderName" (defaults to the part of the email before the "@").
}
